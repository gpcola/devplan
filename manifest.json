{
  "name": "devplan-tracker-pack",
  "version": "1.0.0",
  "schema_version": 1,
  "description": "Standalone DEVPLAN tracker pack for software repositories.",
  "node": ">=20.0.0",
  "entrypoint": "scripts/devplan.mjs",
  "commands": [
    "status",
    "validate",
    "next",
    "report",
    "readiness",
    "list",
    "add-milestone",
    "add-item",
    "update",
    "remove-item",
    "link-item",
    "protect",
    "init",
    "migrate"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "devplan/DEVPLAN.md",
    "devplan/DEVPLAN-STATE.json",
    "devplan/devplan.config.json",
    "manifest.json",
    "package-scripts.json",
    "devplan/schemas/devplan-state.schema.json",
    "scripts/devplan.mjs",
    "scripts/devplan-status.mjs",
    "scripts/devplan-validate.mjs",
    "scripts/devplan-update.mjs",
    "scripts/devplan-report.mjs",
    "install.mjs",
    "devplan/docs/USAGE.md",
    "devplan/docs/GOVERNANCE.md",
    "devplan/docs/AGENT-INSTRUCTIONS.md",
    "devplan/docs/CI.md",
    "devplan/docs/MIGRATION.md",
    "workflows/devplan-check.yml",
    "examples/example.DEVPLAN-STATE.json",
    "tests/devplan-cli.test.mjs"
  ],
  "default_paths": {
    "state": "devplan/DEVPLAN-STATE.json",
    "plan": "devplan/DEVPLAN.md",
    "config": "devplan/devplan.config.json"
  }
}
